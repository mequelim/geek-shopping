@model ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
}

<form asp-action="ProductDelete">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Version" type="hidden" />

    <br/>

    <div class="container border p-3">
        <h1 class="text-primary">Delete Product</h1>

        <hr/>

        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Name:*@
            <div class="col-2">
                <label asp-for="Name" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="Name" class="form-control" disabled />
            </div>

            @* Price: *@
            <div class="col-2">
                <label asp-for="Price" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="Price" class="form-control" disabled />
            </div>

            @* Discount: *@
            <div class="col-2">
                <label asp-for="Discount" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="Discount" class="form-control" disabled />
            </div>

            @* Description: *@
            <div class="col-2">
                <label asp-for="Description" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="Description" class="form-control" disabled />
            </div>

            @* Category: *@
            <div class="col-2">
                <label asp-for="Category" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="Category" class="form-control" disabled />
            </div>

            @* ImageUrl: *@
            <div class="col-2">
                <label asp-for="ImageUrl" class="control-label pt-2" style="font-size: 20px;"></label>
            </div>

            <div class="col-10 pb-3">
                <input asp-for="ImageUrl" class="form-control" disabled />
            </div>

            @* Buttons: *@
            <div class="col-5 offset-2">
                <a asp-action="ProductIndex" class="btn-primary btn form-control">Back to List</a>
            </div>

            <div class="col-5">
                <input type="submit" value="Remove" class="btn btn-danger form-control"/>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}